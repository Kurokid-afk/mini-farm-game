{
  "name": "uu-harvest-collection",
  "version": "2.5.3",
  "private": true,
  "description": "像素农场、宠物园与三种无限小游戏联动的桌面和原生 Android 合集",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4173 electron .",
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-assets.ps1",
    "build:web": "vite build",
    "build": "npm run assets && npm run build:web && electron-builder --win portable",
    "build:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-updater.ps1",
    "test:logic": "node tests/core.test.cjs",
    "test:android-logic": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-android-logic.ps1",
    "test:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-windows-updater.ps1",
    "test:e2e": "node tests/e2e.mjs",
    "test:mobile": "node tests/mobile-e2e.mjs",
    "test:electron": "node tests/electron-e2e.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "37.2.6",
    "electron-builder": "26.0.12",
    "playwright": "1.54.1",
    "vite": "7.0.6"
  },
  "build": {
    "appId": "com.uu.harvestcollection",
    "productName": "UU田园合集",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "UU-Farm-Windows.exe"
    }
  }
}
